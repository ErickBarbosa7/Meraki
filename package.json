{
  "name": "meraki",
  "version": "0.1.0",
  "private": true,
  "description": "MERAKI - Descubre palabras inusuales",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "lottie-react": "^3.1.0"
  }
}
